<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootNotes"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/headerBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp">

            <FrameLayout
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageButton
                    android:id="@+id/btnGuide"
                    style="@style/ToolBtn"
                    android:layout_gravity="start|center_vertical"
                    android:src="@drawable/ic_help"
                    android:contentDescription="@string/guide" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:id="@+id/txtHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name_caps"
                        android:textSize="27sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.24" />

                    <TextView
                        android:id="@+id/txtStorage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.08" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnHomeMenu"
                    style="@style/ToolBtn"
                    android:layout_gravity="end|center_vertical"
                    android:src="@drawable/ic_menu"
                    android:contentDescription="Home menu" />

            </FrameLayout>

            <LinearLayout
                android:id="@+id/selHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/btnSelClose"
                    style="@style/ToolBtn"
                    android:src="@drawable/ic_back"
                    android:contentDescription="@string/deselect_all" />

                <TextView
                    android:id="@+id/txtSelCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.12"
                    android:maxLines="1" />

                <ImageButton
                    android:id="@+id/btnSelectAll"
                    style="@style/ToolBtn"
                    android:src="@drawable/ic_check"
                    android:contentDescription="@string/select_all" />

                <ImageButton
                    android:id="@+id/btnSelExport"
                    style="@style/ToolBtn"
                    android:src="@drawable/ic_share"
                    android:contentDescription="@string/share_export" />

                <ImageButton
                    android:id="@+id/btnSelDelete"
                    style="@style/ToolBtn"
                    android:src="@drawable/ic_delete"
                    android:contentDescription="@string/delete" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/txtEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="90dp"
            android:gravity="center"
            android:paddingTop="4dp"
            android:includeFontPadding="false"
            android:fontFamily="monospace"
            android:letterSpacing="0.12"
            android:textSize="15sp"
            android:lineSpacingExtra="8dp"
            android:text="@string/no_notes"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:scrollbars="none"
            android:paddingBottom="96dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/homeMenuPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="68dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:padding="4dp"
        android:background="@drawable/bg_dialog_dark"
        android:elevation="20dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnTrash"
            style="@style/ToolBtn"
            android:src="@drawable/ic_trash"
            android:contentDescription="Trash" />

        <ImageButton
            android:id="@+id/btnThemeList"
            style="@style/ToolBtn"
            android:src="@drawable/ic_theme"
            android:contentDescription="Theme" />
    </LinearLayout>

    <!-- One split pill: NEW on the left, OPEN on the right. Both keep their
         existing IDs so NotesActivity behaviour is unchanged. -->
    <LinearLayout
        android:id="@+id/notebookActions"
        android:layout_width="260dp"
        android:layout_height="62dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_notebook_actions"
        android:clipToOutline="true"
        android:elevation="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnNew"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:drawableTop="@drawable/ic_new_note_white"
            android:drawablePadding="-1dp"
            android:focusable="true"
            android:fontFamily="monospace"
            android:gravity="center"
            android:paddingTop="10dp"
            android:translationY="2dp"
            android:includeFontPadding="false"
            android:letterSpacing="0.08"
            android:text="@string/new_note_short"
            android:textAllCaps="true"
            android:textColor="@color/pure_white"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/notebookActionDivider"
            android:layout_width="1dp"
            android:layout_height="42dp"
            android:layout_gravity="center_vertical"
            android:alpha="0.9"
            android:background="@color/pure_white" />

        <TextView
            android:id="@+id/btnOpenNotebook"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:drawableTop="@drawable/ic_folder_open_white"
            android:drawablePadding="-1dp"
            android:focusable="true"
            android:fontFamily="monospace"
            android:gravity="center"
            android:paddingTop="10dp"
            android:translationY="2dp"
            android:includeFontPadding="false"
            android:letterSpacing="0.08"
            android:text="@string/open_notebook_short"
            android:textAllCaps="true"
            android:textColor="@color/pure_white"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
