<?xml version="1.0" encoding="utf-8"?>
<!-- Requirement B3 - choose a page mode when creating a notebook (dark, grid of 3). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_dark"
    android:paddingHorizontal="18dp"
    android:paddingTop="18dp"
    android:paddingBottom="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/new_notebook"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:letterSpacing="0.14" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/choose_page_mode"
        android:textColor="#8A8A8A"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.06" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/optInfinite"
            style="@style/PageModeCard">
            <ImageView style="@style/PageModeImg" android:src="@drawable/ic_page_infinite" />
            <TextView style="@style/PageModeLabel" android:text="@string/page_infinite" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/optMulti"
            style="@style/PageModeCard">
            <ImageView style="@style/PageModeImg" android:src="@drawable/ic_page_multi_infinite" />
            <TextView style="@style/PageModeLabel" android:text="@string/page_multi_infinite" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/newCancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="14dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="9dp"
        android:text="@string/cancel"
        android:textColor="#8A8A8A"
        android:textSize="13sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:letterSpacing="0.12"
        android:background="?attr/selectableItemBackgroundBorderless" />
</LinearLayout>
